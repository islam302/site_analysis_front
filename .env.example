# --- API base URL -----------------------------------------------------------
# Default: a RELATIVE path so the browser calls the Vite dev server, which
# proxies to the backend (VITE_API_PROXY_TARGET). This avoids CORS entirely --
# the remote API does not send access-control-allow-origin headers.
VITE_API_BASE_URL=/site-analysis/api/v1

# To talk to the backend DIRECTLY (bypassing the proxy), set an absolute URL.
# Only works if that host allows this app's origin via CORS:
# VITE_API_BASE_URL=https://una-ai-tools-apis.una-oic.org/site-analysis/api/v1

# --- Proxy target (dev only) -------------------------------------------------
# Where the Vite proxy forwards /site-analysis requests (API + media/PDFs).
VITE_API_PROXY_TARGET=https://una-ai-tools-apis.una-oic.org

# Local backend instead:
# VITE_API_PROXY_TARGET=http://localhost:8000

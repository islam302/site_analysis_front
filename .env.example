# --- API base URL -----------------------------------------------------------
# Default: a RELATIVE path so the browser calls the Vite dev server, which
# proxies to the backend (VITE_API_PROXY_TARGET). This avoids CORS entirely and
# works from localhost, 127.0.0.1, and your LAN IP.
VITE_API_BASE_URL=/api/v1

# To talk to a remote backend DIRECTLY (bypassing the proxy), set an absolute
# URL instead — but that backend must allow this app's origin via CORS, e.g.:
# VITE_API_BASE_URL=https://api.example.com/api/v1

# --- Proxy target (dev only) -------------------------------------------------
# Where the Vite proxy forwards /api and /media requests.
VITE_API_PROXY_TARGET=http://localhost:8000
